rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // 1. Blogs Collection
    // - Public: Anyone can read published articles
    // - Public: Anyone can increment/decrement likes on a blog post
    // - CMS Admin/Writer: Authenticated users can create, edit all fields, and delete articles
    match /blogs/{blogId} {
      allow read: if true;
      allow update: if isAuthenticated() || 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']);
      allow create, delete: if isAuthenticated();
    }

    // 2. Comments Collection
    // - Public: Anyone can read comments and submit a comment
    // - Admin: Authenticated users can approve, reject, moderate, and delete comments
    match /comments/{commentId} {
      allow read, create: if true;
      allow update, delete: if isAuthenticated();
    }

    // 3. Media Library Collection
    // - Public: Anyone can read media records (for cover and inline images)
    // - CMS Admin: Can upload and delete media files
    match /media/{mediaId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    // 4. Case Studies Collection
    // - Public: Anyone can read case studies
    // - Admin: Authenticated users can manage case studies
    match /case-studies/{studyId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 5. Users Collection
    // - Allows profile verification, login role checking, and admin user management
    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    // 6. Roles & Permissions Collection
    // - Public: Allows reading roles for permission validation
    // - Admin: Authenticated administrators can manage roles
    match /roles/{roleId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Default fallback rule for any collection
    match /{document=**} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }
  }
}
